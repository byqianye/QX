# Optional authorized Jellyfin validation. Keep real values outside Git.
# Base URL of the authorized Jellyfin server, without credentials or query parameters.
QX_JELLYFIN_URL=
# Jellyfin access token used only in in-memory authenticated requests.
QX_JELLYFIN_TOKEN=
# Authorized Jellyfin user ID used for library and item requests.
QX_JELLYFIN_USER_ID=
