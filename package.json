{
  "name": "qx-yingshi",
  "version": "0.9.0-rc.1",
  "description": "桌面端用户自有媒体与直播内容播放器",
  "author": "QX影视",
  "private": true,
  "main": "dist/electron/src/electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:contracts": "vitest run tests/tauri-contract.test.ts --reporter=dot",
    "test:storage": "vitest run tests/tauri-storage-contract.test.ts tests/tauri-source-session-contract.test.ts tests/tauri-runtime-capability.test.ts tests/sqlite-data-layer.test.ts --reporter=dot",
    "check:frontend": "npm run typecheck && npm run renderer:build",
    "check:rust": "tsx scripts/check-rust.ts",
    "check:tauri": "npm run check:frontend && npm run check:rust",
    "tauri:dev": "tsx scripts/tauri-command.ts dev",
    "tauri:build": "tsx scripts/tauri-command.ts build",
    "build:windows:x64": "tsx scripts/tauri-command.ts build --bundles nsis --target x86_64-pc-windows-msvc",
    "build": "tsx scripts/release-build.ts",
    "prepack-check": "tsx scripts/prepack-check.ts",
    "preview:build": "npm run android-host:build && npm run build && npm run prepack-check",
    "preview:dir": "npm run preview:build && electron-builder --config electron-builder.preview.yml --dir --x64",
    "preview:installer": "npm run preview:build && electron-builder --config electron-builder.preview.yml --win nsis --x64",
    "preview:portable": "npm run preview:build && electron-builder --config electron-builder.preview.yml --win portable --x64",
    "preview:smoke": "tsx scripts/preview-smoke.ts",
    "preview:android-playback": "tsx scripts/packaged-android-playback.ts",
    "preview:android-clean-e2e": "tsx scripts/clean-windows-android-e2e.ts",
    "rc:build": "npm run android-host:build && npm run build && npm run prepack-check",
    "rc:dir": "npm run rc:build && electron-builder --config electron-builder.rc.yml --dir --x64",
    "rc:installer": "npm run rc:build && electron-builder --config electron-builder.rc.yml --win nsis --x64",
    "rc:portable": "npm run rc:build && electron-builder --config electron-builder.rc.yml --win portable --x64",
    "rc:artifacts": "tsx scripts/build-windows-rc.ts",
    "rc:clean-install": "tsx scripts/rc-clean-install.ts",
    "rc:upgrade": "tsx scripts/rc-upgrade-e2e.ts",
    "rc:uninstall": "tsx scripts/rc-uninstall-smoke.ts",
    "rc:portable-smoke": "tsx scripts/rc-portable-smoke.ts",
    "pack": "npm run android-host:build && npm run build && npm run prepack-check && electron-builder --dir",
    "dist:win": "npm run android-host:build && npm run build && npm run prepack-check && electron-builder --win --x64",
    "dist:win:installer": "npm run android-host:build && npm run build && npm run prepack-check && electron-builder --win nsis --x64",
    "dist:win:portable": "npm run android-host:build && npm run build && npm run prepack-check && electron-builder --win portable --x64",
    "renderer:build": "vite build --config vite.config.ts",
    "brand:assets": "tsx src/release/generate-brand-assets.ts",
    "electron:build-runtime": "tsx src/electron/package-runtime.ts",
    "electron:build": "npm run brand:assets && npm run electron:build-runtime && npm run renderer:build && tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:build && electron .",
    "electron:smoke": "npm run electron:build && tsx src/electron/smoke-launch.ts",
    "electron:package:win": "npm run electron:build && electron-packager . QX影视 --platform=win32 --arch=x64 --out=dist/electron-package --overwrite --prune=true --icon=build/assets/qx-yingshi.ico --extra-resource=dist/electron-runtime --extra-resource=build/assets/qx-yingshi.ico",
    "electron:installer:win": "npm run dist:win:installer",
    "electron:e2e:unpacked": "tsx scripts/packaged-smoke.ts release/win-unpacked/QX影视.exe",
    "electron:e2e:package": "npm run electron:package:win && tsx src/electron/e2e-launch.ts",
    "electron:installer:e2e": "tsx src/electron/installer-e2e.ts",
    "electron:g76:local": "tsx src/electron/g76-local-acceptance.ts",
    "electron:verify:no-jdk": "tsx src/electron/jdk-missing-launch.ts",
    "electron:verify:network-timeout": "tsx src/electron/network-timeout-launch.ts",
    "electron:acceptance": "npm run electron:e2e:package && npm run electron:verify:no-jdk && npm run electron:verify:network-timeout",
    "python:smoke": "tsx src/electron/python-smoke.ts",
    "mpv:smoke": "tsx src/electron/mpv-smoke.ts",
    "aria2:smoke": "tsx src/electron/aria2-smoke.ts",
    "release:inventory": "tsx src/release/release-inventory.ts",
    "spike:config": "tsx src/spikes/config-probe.ts",
    "spike:js": "tsx src/spikes/js-probe.ts",
    "spike:python": "tsx src/spikes/python-probe.ts",
    "spike:java": "tsx src/spikes/java-probe.ts",
    "spike:jvm": "tsx src/spikes/jvm-probe.ts",
    "spike:player": "tsx src/spikes/playable-player-probe.ts",
    "spike:android-spider": "tsx src/spikes/android-spider-poc.ts",
    "spike:android-runtime-v1": "tsx src/spikes/android-runtime-v1.ts",
    "g105:source-audit": "tsx scripts/g105-source-audit.ts",
    "spike:douban": "tsx src/spikes/douban-probe.ts",
    "spike:douban-detail": "tsx src/spikes/douban-detail-probe.ts",
    "spike:douban-detail-sidecar": "tsx src/spikes/douban-detail-sidecar-probe.ts",
    "spike:douban-search": "tsx src/spikes/douban-search-sidecar-probe.ts",
    "spike:douban-search-detail": "tsx src/spikes/douban-search-detail-sidecar-probe.ts",
    "spike:douban-desktop-client": "tsx src/spikes/douban-desktop-client-probe.ts",
    "spike:douban-desktop-session": "tsx src/spikes/douban-desktop-session-probe.ts",
    "spike:douban-desktop-ui": "tsx src/spikes/douban-desktop-ui-probe.ts",
    "spike:douban-desktop-import": "tsx src/spikes/douban-desktop-import-probe.ts",
    "spike:douban-player": "tsx src/spikes/douban-player-probe.ts",
    "spike": "tsx src/spikes/run-all.ts",
    "runtime:audit": "tsx src/spikes/runtime-audit.ts",
    "android-host:build": "tsx scripts/android-host.ts build",
    "android-host:install": "tsx scripts/android-host.ts install",
    "android-host:start": "tsx scripts/android-host.ts start",
    "android-host:stop": "tsx scripts/android-host.ts stop",
    "android-host:check": "tsx scripts/android-host.ts check",
    "android-host:check:qx": "tsx scripts/android-host.ts check --qx"
  },
  "dependencies": {
    "hls.js": "^1.6.17",
    "quickjs-emscripten": "^0.32.0",
    "saxes": "^6.0.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@electron/packager": "^20.1.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
