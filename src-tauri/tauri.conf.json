{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QX影视",
  "version": "0.9.0-rc.1",
  "identifier": "com.qx.yingshi.desktop",
  "build": {
    "beforeDevCommand": "npm run tauri:prepare-sidecar:dev && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run renderer:build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
        {
          "label": "main",
          "create": false,
          "title": "QX影视",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["**"] },
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:; img-src 'self' data: blob: http: https: asset:; media-src 'self' data: blob: http: https: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/assets/qx-yingshi.ico"],
    "resources": {},
    "windows": {
      "nsis": {
        "installerHooks": "../build/tauri-installer.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
